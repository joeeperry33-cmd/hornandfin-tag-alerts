{
  "name": "hornandfin-tag-alerts",
  "version": "0.1.0",
  "private": true,
  "description": "Leftover and returned hunting tag alerts for hornandfin.com",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute hornandfin-tag-alerts --remote --file=migrations/0001_init.sql",
    "db:seed": "wrangler d1 execute hornandfin-tag-alerts --remote --file=migrations/0002_sources.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.151.3"
  }
}
